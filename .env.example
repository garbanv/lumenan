# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/analytics

# Salt for the rotating visitor hash. Must be long, random and STABLE:
# changing it makes every visitor look new and resets unique counts.
# Generate one with:  openssl rand -hex 32
# This is a placeholder. Put the real value in .env, which is gitignored.
VISITOR_SALT=change-me-to-a-long-random-string

# Public origin of this deployment, used for absolute URLs and the tracking
# snippets shown in the dashboard. Omit to fall back to localhost:3000, or to
# VERCEL_URL when deployed there.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Number of reverse proxies in front of the app that append to X-Forwarded-For.
# 1 = one proxy (Traefik, nginx, Vercel). 2 = CDN + proxy (e.g. Cloudflare + Traefik).
# Too high lets visitors spoof their IP; too low attributes traffic to your proxy.
TRUSTED_PROXY_HOPS=1
